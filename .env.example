# Mot de passe de connexion à /admin.
# Si absent, un mot de passe est généré automatiquement au premier
# démarrage et affiché dans les logs du serveur.
ADMIN_PASSWORD=

# Identifiants Cloudflare R2 (upload, optimisation et stockage des photos
# produit). Crée un compte gratuit sur https://dash.cloudflare.com/ (une
# carte bancaire est demandée pour activer R2, mais rien n'est facturé
# sous le quota gratuit de 10 Go), crée un bucket, puis génère un jeton
# API R2 (permissions "Object Read & Write") pour obtenir ces valeurs.
# Sans elles, l'upload de photos est désactivé (un pictogramme de secours
# est utilisé à la place).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL publique du bucket : le sous-domaine r2.dev fourni par Cloudflare
# (Settings > Public Access du bucket), ou ton propre domaine personnalisé.
R2_PUBLIC_URL=

# Identifiants Resend (envoi de l'e-mail de confirmation de commande au
# client). Crée un compte gratuit sur https://resend.com/ (3000 e-mails/mois
# offerts), puis génère une clé API dans Dashboard > API Keys.
# Sans RESEND_API_KEY, les commandes sont bien enregistrées mais aucun
# e-mail de confirmation n'est envoyé (l'admin peut le renvoyer plus tard
# une fois la clé configurée).
RESEND_API_KEY=
# Adresse d'expédition des e-mails. Par défaut, utilise l'adresse de test
# de Resend (onboarding@resend.dev) — pour utiliser ton propre nom de
# domaine, vérifie-le d'abord dans Dashboard > Domains sur resend.com.
RESEND_FROM_EMAIL=NANOBO <onboarding@resend.dev>

# Port d'écoute du serveur (3000 par défaut).
PORT=3000
