# Mot de passe de connexion à /admin.
# Si absent, un mot de passe est généré automatiquement au premier
# démarrage et affiché dans les logs du serveur.
ADMIN_PASSWORD=

# Identifiants Cloudinary (upload & optimisation des photos produit).
# Crée un compte gratuit sur https://cloudinary.com/ puis récupère ces
# 3 valeurs depuis le Dashboard ("Product Environment Credentials").
# Sans eux, l'upload de photos est désactivé (un pictogramme de secours
# est utilisé à la place).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Port d'écoute du serveur (3000 par défaut).
PORT=3000
